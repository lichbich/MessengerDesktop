<Window x:Class="MessengerNative.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng nhập Facebook Messenger" 
        Height="720" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#18191A"
        Foreground="#E4E6EB"
        FontFamily="Segoe UI, Inter, Roboto">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#242526" BorderBrush="#3A3B3C" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Messenger Gradient Icon -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00C6FF" Offset="0.0"/>
                            <GradientStop Color="#0078FF" Offset="0.6"/>
                            <GradientStop Color="#A800FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M 12 18 L 18 12 L 23 16 L 31 10 L 25 22 L 20 18 Z" 
                          Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="20" Height="20"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Đăng nhập Facebook Messenger" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Đăng nhập 1 lần duy nhất. Trình duyệt sẽ tự động đóng và giải phóng RAM ngay sau khi đăng nhập." 
                               FontSize="12" Foreground="#B0B3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnReload" Content="🔄 Tải lại trang (F5)" 
                            Background="#3A3B3C" Foreground="#E4E6EB" BorderThickness="0"
                            Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Click="BtnReload_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnApprovedOnPhone" Content="✅ Tôi đã duyệt trên điện thoại" 
                            Background="#0084FF" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold"
                            Padding="14,8" Margin="0,0,8,0" Cursor="Hand" Click="BtnApprovedOnPhone_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnSwitchMode" Content="Dán Cookie thủ công" 
                            Background="#3A3B3C" Foreground="#E4E6EB" BorderThickness="0"
                            Padding="14,8" Cursor="Hand" Click="BtnSwitchMode_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Mode 1: WebView2 Container -->
            <Grid x:Name="GridWebView" Visibility="Visible">
                <wv2:WebView2 x:Name="WvLogin" Source="https://www.messenger.com/login/" />
                
                <!-- Overlay Status when logged in -->
                <Border x:Name="BorderSuccessOverlay" Background="#E618191A" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="240" Height="4" Foreground="#0084FF" Background="#3A3B3C" BorderThickness="0"/>
                        <TextBlock Text="Đăng nhập thành công!" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,20,0,6" HorizontalAlignment="Center"/>
                        <TextBlock Text="Đang lưu phiên bảo mật và giải phóng 100% RAM..." FontSize="13" Foreground="#B0B3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mode 2: Manual Cookie Input -->
            <Grid x:Name="GridManualCookie" Visibility="Collapsed" Background="#18191A">
                <Border Background="#242526" BorderBrush="#3A3B3C" BorderThickness="1" CornerRadius="12" 
                        Width="650" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel>
                        <TextBlock Text="Dán chuỗi Cookie từ trình duyệt" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                        <TextBlock Text="Dành cho lập trình viên hoặc nếu bạn không muốn đăng nhập lại tài khoản trên giao diện web này. Bạn có thể copy chuỗi cookie (có chứa c_user và xs) từ Chrome/Edge và dán vào đây:" 
                                   FontSize="13" Foreground="#B0B3B8" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                        <TextBox x:Name="TxtManualCookie" Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#3A3B3C" Foreground="#FFFFFF" BorderBrush="#4E4F50" BorderThickness="1"
                                 Padding="12" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <TextBlock x:Name="TxtCookieError" Text="" Foreground="#FA383E" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Quay lại WebView" Background="Transparent" Foreground="#B0B3B8" BorderThickness="0"
                                    Padding="14,10" Margin="0,0,12,0" Cursor="Hand" Click="BtnBackToWeb_Click"/>
                            <Button Content="Xác nhận &amp; Đăng nhập" Background="#0084FF" Foreground="#FFFFFF" BorderThickness="0"
                                    FontWeight="SemiBold" Padding="20,10" Cursor="Hand" Click="BtnConfirmCookie_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#242526" BorderBrush="#3A3B3C" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng đăng nhập..." FontSize="12" Foreground="#B0B3B8" VerticalAlignment="Center"/>
                <TextBlock Text="Bảo mật bằng Windows DPAPI • Không chia sẻ cookie" FontSize="12" Foreground="#777" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
