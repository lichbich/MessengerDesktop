<Window x:Class="MessengerNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Messenger" 
        Icon="Assets/messenger.ico"
        Height="800" Width="1200"
        MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Inter, Roboto">

    <!-- Unified 1-Row Windows 11 Chrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6" 
                      CornerRadius="8" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 Style Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Fluent Caption Button Style (Minimize / Maximize) -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Fluent Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" Background="#202020" BorderBrush="#2D2D2D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 1-ROW TITLE BAR (WINDOWS 11 FILE EXPLORER STYLE) ==================== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#202020" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Messenger Icon, App Title & Explorer-style Nav Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- App Icon -->
                        <Image Source="Assets/messenger.ico" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <!-- App Title -->
                        <TextBlock x:Name="TxtAppTitle" Text="Messenger" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- Divider -->
                        <Border x:Name="SepDivider" Width="1" Height="16" Background="#3A3A3A" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <!-- Navigation Controls: Back, Forward, Reload -->
                        <Button x:Name="BtnNavBack" Style="{StaticResource NavButtonStyle}" ToolTip="Quay lại (Alt + Left)" Click="BtnNavBack_Click">
                            <TextBlock x:Name="TxtNavBack" Text="←" FontSize="14" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button x:Name="BtnNavForward" Style="{StaticResource NavButtonStyle}" ToolTip="Tiến lên (Alt + Right)" Click="BtnNavForward_Click">
                            <TextBlock x:Name="TxtNavForward" Text="→" FontSize="14" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button x:Name="BtnNavReload" Style="{StaticResource NavButtonStyle}" ToolTip="Tải lại trang (F5)" Click="BtnNavReload_Click" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtNavReload" Text="↻" FontSize="15" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Button>
                    </StackPanel>

                    <!-- Center: Status Text & Drag Window Region -->
                    <TextBlock x:Name="TxtWindowTitle" Grid.Column="1" Text="Trực tuyến" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="#8A8D91" FontSize="12"/>

                    <!-- Right: Windows 11 Native-Style Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize Button -->
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButtonStyle}" ToolTip="Thu nhỏ" Click="BtnMinimize_Click">
                            <TextBlock x:Name="TxtMinIcon" Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" ToolTip="Phóng to" Click="BtnMaximize_Click">
                            <TextBlock x:Name="TxtMaxIcon" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose" Style="{StaticResource CloseButtonStyle}" ToolTip="Đóng" Click="BtnClose_Click">
                            <TextBlock x:Name="TxtCloseIcon" Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN CONTENT ==================== -->
            <Grid Grid.Row="1">
                <!-- WebView2 Messenger Container -->
                <wv2:WebView2 x:Name="WvMessenger"/>

                <!-- Clean Loading Overlay -->
                <Border x:Name="BorderLoadingSplash" Background="#202020" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Assets/messenger.ico" Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLoadingTitle" Text="Đang kết nối Facebook Messenger..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLoadingSubtitle" Text="Đang tải dữ liệu hội thoại..." FontSize="12" Foreground="#8A8D91" Margin="0,4,0,16" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="220" Height="3" Foreground="#0084FF" Background="#333333" BorderThickness="0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
